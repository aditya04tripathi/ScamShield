# VPS deployment: copy to .env, chmod 600 .env, then set a random secret.
APP_PORT=3000
IMAGE_PREFIX=ghcr.io/aditya04tripathi/scamshield
IMAGE_TAG=latest
JWT_SECRET_KEY=change-me-use-at-least-32-characters
# Ollama is optional. The host daemon must accept requests from Docker's bridge.
OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=granite3.1-moe:3b
